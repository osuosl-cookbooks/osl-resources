# ifcfg config file written by Chef
<% if @bcast -%>
BROADCAST=<%= @bcast %>
<% end -%>
<% if @bonding_opts -%>
BONDING_OPTS="<%= @bonding_opts %>"
BONDING_MASTER=yes
<% end -%>
<% if @bootproto -%>
BOOTPROTO=<%= @bootproto %>
<% end -%>
<% if @bridge -%>
BRIDGE=<%= @bridge %>
<% end -%>
<% if @defroute -%>
DEFROUTE=<%= @defroute %>
<% end -%>
<% if @delay -%>
DELAY=<%= @delay %>
<% end -%>
<% if @device -%>
DEVICE=<%= @device %>
<% end -%>
<% if @ethtool_opts -%>
ETHTOOL_OPTS="<%= @ethtool_opts %>"
<% end -%>
<% if @gateway -%>
GATEWAY=<%= @gateway %>
<% end -%>
<% if @hwaddr -%>
HWADDR=<%= @hwaddr %>
<% end -%>
<%
  # ifcfg carries one primary address; the rest join ipv6addrsec rather than
  # being dropped.
  v6 = Array(@ipv6addr)
  v6sec = v6.drop(1) + Array(@ipv6addrsec)
-%>
<% unless v6.empty? -%>
IPV6ADDR=<%= v6.first %>
<% end -%>
<% unless v6sec.empty? -%>
IPV6ADDR_SECONDARIES='<%= v6sec.join(' ') %>'
<% end -%>
<% if @ipv6_defaultgw -%>
IPV6_DEFAULTGW=<%= @ipv6_defaultgw %>
<% end -%>
<% if @ipv6init -%>
IPV6INIT=<%= @ipv6init %>
<% end -%>
<% if @ipv6_autoconf -%>
IPV6_AUTOCONF=<%= @ipv6_autoconf %>
<% end -%>
<%
  # A lone mask covers every address, as on the nmstate path. Addresses with
  # their own CIDR get a PREFIX<n>= below instead.
  addrs = Array(@ipv4addr)
  masks = Array(@mask)
  netmasks = if addrs.empty?
               masks
             else
               addrs.each_index.map do |i|
                 next if addrs[i].to_s.include?('/')
                 masks[i] || (masks.one? ? masks.first : nil)
               end
             end
-%>
<% netmasks.each_with_index do |mask, idx| -%>
<% next if mask.nil? -%>
NETMASK<%= idx.zero? ? '' : idx %>=<%= mask %>
<% end -%>
<% if @master -%>
MASTER=<%= @master %>
<% end -%>
<% if @metric -%>
METRIC=<%= @metric %>
<% end -%>
<% if @mtu -%>
MTU=<%= @mtu %>
<% end -%>
<% if @network -%>
NETWORK=<%= @network %>
<% end -%>
<% if @nm_controlled -%>
NM_CONTROLLED=<%= @nm_controlled %>
<% end -%>
<% if @onboot -%>
ONBOOT=<%= @onboot %>
<% end -%>
<% if @onparent -%>
ONPARENT=<%= @onparent %>
<% end -%>
<% if @peerdns -%>
PEERDNS=<%= @peerdns %>
<% end -%>
<% if @slave -%>
SLAVE=<%= @slave %>
<% end -%>
<% addrs.each_with_index do |ip, idx| -%>
<% addr, cidr = ip.to_s.split('/') -%>
IPADDR<%= idx.zero? ? '' : idx %>=<%= addr %>
<% if cidr -%>
PREFIX<%= idx.zero? ? '' : idx %>=<%= cidr %>
<% end -%>
<% end -%>
<% if @type -%>
TYPE=<%= @type %>
<% end -%>
<% if @userctl -%>
USERCTL=<%= @userctl %>
<% end -%>
<% if @vlan -%>
VLAN=<%= @vlan %>
<% end -%>
