# This file was generated by Chef
# Do NOT modify this file by hand!
<% @pools.each do |pool, options| -%>
<%= "pool #{pool} #{options}" %>
<% end -%>
<% @servers.each do |server, options| -%>
<%= "server #{server} #{options}" %>
<% end -%>
<% @peers.each do |peer| -%>
<%= "peer #{peer} key #{@key_id}" %>
<% end -%>
<% @allowed_networks.each do |network| -%>
<%= "allow #{network}" %>
<% end -%>
<% @conf.each do |key, value| -%>
<% if value.nil? -%>
<%= key %>
<% else -%>
<%= key %> <%= value %>
<% end -%>
<% end -%>
<% if @nts_server_cert && @nts_server_key -%>
ntsservercert <%= @nts_server_cert %>
ntsserverkey <%= @nts_server_key %>
<% end -%>
